    "The date is in %@ time, wherever you are.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Zeit gilt in %@, egal wo du bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La hora es la de %@, estés donde estés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’heure est celle de %@, où que vous soyez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "日時は%@の時刻です。どこにいても変わりません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O horário é o de %@, onde quer que você esteja."
          }
        }
      }
    },
    "The link stops working for everyone and the copy on Count Downcula's server is deleted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Link funktioniert dann für niemanden mehr, und die Kopie auf dem Server von Count Downcula wird gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El enlace deja de funcionar para todos y se elimina la copia del servidor de Count Downcula."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le lien cesse de fonctionner pour tout le monde et la copie sur le serveur de Count Downcula est supprimée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "全員のリンクが無効になり、Count Downculaのサーバ上のコピーは削除されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O link para de funcionar para todos e a cópia no servidor do Count Downcula é apagada."
          }
        }
      }
    },
    "The old link keeps working too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der alte Link funktioniert weiterhin."
          }
        },
        "es": {
