    "Allow Count Downcula to read your calendars in Settings to pick events here. Events stay on your iPhone; only the countdowns you add sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlaube Count Downcula in den Einstellungen, deine Kalender zu lesen, um hier Ereignisse auszuwählen. Ereignisse bleiben auf deinem iPhone; nur die Countdowns, die du hinzufügst, werden synchronisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que Count Downcula lea tus calendarios en Ajustes para elegir eventos aquí. Los eventos se quedan en tu iPhone; solo se sincronizan las cuentas atrás que añadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorisez Count Downcula à lire vos calendriers dans Réglages pour choisir des évènements ici. Les évènements restent sur votre iPhone ; seuls les comptes à rebours ajoutés sont synchronisés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ここでイベントを選ぶには、設定でCount Downculaにカレンダーへのアクセスを許可してください。イベントはiPhoneから出ません。同期されるのは追加したカウントダウンだけです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permita que o Count Downcula leia seus calendários em Ajustes para escolher eventos aqui. Os eventos ficam no seu iPhone; só as contagens que você adicionar são sincronizadas."
          }
        }
      }
    },
    "Allow Count Downcula to read your calendars in System Settings to pick events here. Events stay on your Mac; only the countdowns you add sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlaube Count Downcula in den Systemeinstellungen, deine Kalender zu lesen, um hier Termine auszuwählen. Termine bleiben auf deinem Mac; nur die Countdowns, die du hinzufügst, werden synchronisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que Count Downcula lea tus calendarios en Ajustes del Sistema para elegir eventos aquí. Los eventos se quedan en tu Mac; solo se sincronizan las cuentas atrás que añades."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorisez Count Downcula à lire vos calendriers dans Réglages Système pour choisir des événements ici. Les événements restent sur votre Mac ; seuls les comptes à rebours ajoutés sont synchronisés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ここでイベントを選ぶには、システム設定でCount Downculaにカレンダーへのアクセスを許可してください。イベントはMacに残り、同期されるのは追加したカウントダウンだけです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permita que o Count Downcula leia seus calendários nos Ajustes do Sistema para escolher eventos aqui. Os eventos ficam no seu Mac; só as contagens que você adicionar são sincronizadas."
          }
