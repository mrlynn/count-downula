    "One pass hosts this countdown. Everyone counting down gets the bigger coffin too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Pass richtet diesen Countdown aus. Alle, die mitzählen, bekommen auch den größeren Sarg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un pase organiza esta cuenta atrás. Todos los que cuentan también tienen el ataúd más grande."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un pass organise ce compte à rebours. Tous ceux qui comptent profitent aussi du cercueil agrandi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1つのパスでこのカウントダウンを主催できます。一緒にカウントダウンする全員が大きな棺を使えます。"
          }
        },
        "pt-BR": {
