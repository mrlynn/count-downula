    "Count Downcula needs your rough location to know when the sun rises and sets. You can allow it in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Count Downcula braucht deinen ungefähren Standort, um Sonnenauf- und -untergang zu kennen. Du kannst ihn in den Einstellungen erlauben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Count Downcula necesita tu ubicación aproximada para saber cuándo sale y se pone el sol. Puedes permitirlo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Count Downcula a besoin de votre position approximative pour connaître le lever et le coucher du soleil. Vous pouvez l’autoriser dans Réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "日の出と日の入りの時刻を知るには、おおよその現在地が必要です。設定で許可できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Count Downcula precisa da sua localização aproximada para saber quando o sol nasce e se põe. Você pode permitir em Ajustes."
          }
        }
      }
    },
