    "Free includes %lld active countdowns at a time. Unlock Unlimited, or finish or delete one first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kostenlos sind %lld aktive Countdowns gleichzeitig möglich. Schalte Unlimited frei oder beende oder lösche zuerst einen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La versión gratis incluye %lld cuentas atrás activas a la vez. Desbloquea Unlimited o termina o elimina una primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La version gratuite inclut %lld comptes à rebours actifs à la fois. Débloquez Unlimited, ou terminez ou supprimez-en un d’abord."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無料版では同時に%lld個までカウントダウンできます。Unlimitedを解除するか、どれかを終了または削除してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O plano grátis inclui %lld contagens ativas ao mesmo tempo. Desbloqueie o Unlimited ou conclua ou apague uma antes."
          }
        }
      }
    },
    "Free includes %lld at a time, so %lld more will fit. Pick more and Unlimited adds the rest.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kostenlos sind %1$lld gleichzeitig möglich, also passen noch %2$lld. Wähle mehr, und Unlimited fügt den Rest hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Free includes %1$lld at a time, so %2$lld more will fit. Pick more and Unlimited adds the rest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La versión gratis incluye %1$lld a la vez, así que caben %2$lld más. Elige más y Unlimited añade el resto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La version gratuite en inclut %1$lld à la fois, il reste donc de la place pour %2$lld. Choisissez-en plus et Unlimited ajoute le reste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無料版では同時に%1$lld個までなので、あと%2$lld個追加できます。それ以上選ぶと、残りはUnlimitedで追加できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O plano grátis inclui %1$lld ao mesmo tempo, então cabem mais %2$lld. Escolha mais e o Unlimited adiciona o resto."
          }
        }
      }
    },
    "Free includes %lld countdowns at a time, and you're there. Pick what you like; Unlimited adds them all.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kostenlos sind %lld Countdowns gleichzeitig möglich, und die hast du. Wähle, was du willst; Unlimited fügt alles hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La versión gratis incluye %lld cuentas atrás a la vez y ya las tienes. Elige lo que quieras; Unlimited las añade todas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La version gratuite inclut %lld comptes à rebours à la fois, et vous y êtes. Choisissez ce que vous voulez ; Unlimited les ajoute tous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無料版では同時に%lld個までで、上限に達しています。好きなものを選べば、Unlimitedですべて追加できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O plano grátis inclui %lld contagens ao mesmo tempo, e você já chegou lá. Escolha o que quiser; o Unlimited adiciona tudo."
          }
        }
      }
    },
    "Free includes %lld countdowns at a time. Unlock unlimited countdowns on all your devices.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kostenlos sind %lld Countdowns gleichzeitig möglich. Schalte unbegrenzte Countdowns auf all deinen Geräten frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La versión gratis incluye %lld cuentas atrás a la vez. Desbloquea cuentas atrás ilimitadas en todos tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La version gratuite inclut %lld comptes à rebours à la fois. Débloquez-les en illimité sur tous vos appareils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
