    "Everyone with the link sees your guess. The closest one wins once the real date is in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle mit dem Link sehen deinen Tipp. Wer am nächsten dran liegt, gewinnt, sobald das echte Datum feststeht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todos los que tengan el enlace ven tu apuesta. Gana la más cercana cuando se sepa la fecha real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toute personne disposant du lien voit votre pronostic. Le plus proche gagne une fois la vraie date connue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "リンクを知っている人全員にあなたの予想が表示されます。実際の日付が決まったら、一番近い予想が勝ちです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todos com o link veem seu palpite. O mais próximo vence quando a data real for definida."
          }
        }
