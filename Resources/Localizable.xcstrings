    "Add a trip, a launch, a birthday or a quick timer.\nCountdowns from your Mac and Apple Watch show up here too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Füge eine Reise, einen Launch, einen Geburtstag oder einen schnellen Timer hinzu.\nCountdowns von deinem Mac und deiner Apple Watch erscheinen auch hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Añade un viaje, un lanzamiento, un cumpleaños o un temporizador rápido.\nLas cuentas atrás de tu Mac y tu Apple Watch también aparecen aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajoutez un voyage, un lancement, un anniversaire ou un minuteur rapide.\nLes comptes à rebours de votre Mac et de votre Apple Watch apparaissent aussi ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "旅行、リリース、誕生日、クイックタイマーを追加しましょう。\nMacやApple Watchのカウントダウンもここに表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adicione uma viagem, um lançamento, um aniversário ou um timer rápido.\nAs contagens do seu Mac e Apple Watch também aparecem aqui."
          }
        }
      }
    },
