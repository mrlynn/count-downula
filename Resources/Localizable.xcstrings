    },
    "Only the device that published this link, or one signed in to the same iCloud Keychain, can change it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur das Gerät, das diesen Link veröffentlicht hat, oder eines mit demselben iCloud-Schlüsselbund kann ihn ändern."
          }
        },
        "es": {
