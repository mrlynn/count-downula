    "Countdowns you make on your iPhone, iPad or Mac show up here through iCloud. Or scan the code to make one on the web.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Countdowns, die du auf iPhone, iPad oder Mac erstellst, erscheinen hier über iCloud. Oder scanne den Code, um einen im Web zu erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las cuentas atrás que creas en tu iPhone, iPad o Mac aparecen aquí a través de iCloud. O escanea el código para crear una en la web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
