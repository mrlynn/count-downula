    "%lld countdowns didn't fit the free tier, including %@. Unlock Unlimited and add them again any time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld Countdowns passten nicht ins kostenlose Kontingent, darunter %2$@. Schalte Unlimited frei und füge sie jederzeit wieder hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld countdowns didn't fit the free tier, including %2$@. Unlock Unlimited and add them again any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld cuentas atrás no cupieron en la versión gratis, entre ellas %2$@. Desbloquea Unlimited y añádelas cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld comptes à rebours n’ont pas tenu dans la version gratuite, dont %2$@. Débloquez Unlimited et ajoutez-les quand vous voulez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld個のカウントダウンが無料枠に入りませんでした（%2$@など）。Unlimitedを解除すれば、いつでも追加できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld contagens não couberam no plano grátis, incluindo %2$@. Desbloqueie o Unlimited e adicione de novo quando quiser."
          }
        }
      }
    },
