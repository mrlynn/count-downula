# Copy to .env.local for `npm run dev`.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=countdowncula
PUBLIC_ORIGIN=http://localhost:4300
# Salts the hashed client addresses used for rate limits. Any long random string.
RATE_LIMIT_SALT=change-me
# Password for /admin/metrics (any user name). At least 16 characters; the dashboard stays shut without it.
METRICS_PASSWORD=
# Emailed edit links for countdowns made on the web: a Resend key and a sender on a verified domain.
RESEND_API_KEY=
EMAIL_FROM=
# Optional: where replies to those emails (and to coffin reports) go, when the sending domain has no inbox.
EMAIL_REPLY_TO=
# Local testing only: accept Host Pass transactions from Xcode's StoreKit testing (signed by Xcode,
# not Apple). Never set this in production.
HOST_PASS_ALLOW_XCODE=
