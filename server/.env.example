# Copy to .env.local for `npm run dev`.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=countdowncula
PUBLIC_ORIGIN=http://localhost:4300
# Salts the hashed client addresses used for rate limits. Any long random string.
RATE_LIMIT_SALT=change-me
# Password for /admin/metrics (any user name). At least 16 characters; the dashboard stays shut without it.
METRICS_PASSWORD=
